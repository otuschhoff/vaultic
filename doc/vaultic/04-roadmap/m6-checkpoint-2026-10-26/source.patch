diff --git a/internal/index/legacyimport/tree_cache.go b/internal/index/legacyimport/tree_cache.go
new file mode 100644
index 0000000..b49a0df
--- /dev/null
+++ b/internal/index/legacyimport/tree_cache.go
@@ -0,0 +1,227 @@
+package legacyimport
+
+import (
+	"bytes"
+	"context"
+	"sync"
+
+	"github.com/otuschhoff/vaultic/internal/data"
+	"github.com/otuschhoff/vaultic/internal/vaultic"
+	"github.com/otuschhoff/vaultic/internal/workingstate"
+)
+
+const (
+	snapshotTreeCacheBytes       = 256 << 20
+	snapshotTreeCacheSlots       = 1 << 16
+	snapshotTreeCacheWays        = 4
+	snapshotTreeCacheMaxTreeSize = 1 << 20
+	snapshotTreeCacheBookkeeping = 2*snapshotTreeCacheSlots*8 + 4096
+)
+
+type snapshotTreeCacheEntry struct {
+	id      vaultic.ID
+	encoded []byte
+	charge  uint64
+	readers uint64
+	lastUse uint64
+}
+
+type snapshotTreeCache struct {
+	mu      sync.Mutex
+	entries []*snapshotTreeCacheEntry
+	used    uint64
+	oldest  int
+	readers uint64
+	closed  bool
+	clock   uint64
+	release func()
+	probe   *snapshotMechanismCounters
+}
+
+func newSnapshotTreeCache(ctx context.Context) *snapshotTreeCache {
+	if ctx.Err() != nil {
+		return nil
+	}
+	if _, accounted := workingstate.PolicyFrom(ctx).(interface {
+		Reserve(uint64) error
+		Release(uint64)
+	}); !accounted {
+		return nil
+	}
+	release, err := workingstate.Reserve(ctx, snapshotTreeCacheBytes)
+	if err != nil {
+		return nil
+	}
+	if ctx.Err() != nil {
+		release()
+		return nil
+	}
+	return &snapshotTreeCache{
+		entries: make([]*snapshotTreeCacheEntry, snapshotTreeCacheSlots),
+		release: sync.OnceFunc(release),
+		probe:   snapshotMechanismFrom(ctx),
+	}
+}
+
+func snapshotTreeCacheSlot(id vaultic.ID) int {
+	return (int(id[0])<<8 | int(id[1])) & ^(snapshotTreeCacheWays - 1)
+}
+
+func (cache *snapshotTreeCache) loadTree(ctx context.Context, loader vaultic.BlobLoader, id vaultic.ID) (data.TreeNodeIterator, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	counters := snapshotMechanismFrom(ctx)
+	if counters != nil {
+		counters.requests.Add(1)
+	}
+	if cache == nil {
+		if counters == nil {
+			return data.LoadTree(ctx, loader, id)
+		}
+		counters.bypasses.Add(1)
+		encoded, err := loadSnapshotMechanismBlob(ctx, loader, id, counters)
+		if err != nil {
+			return nil, err
+		}
+		return data.NewTreeNodeIterator(bytes.NewReader(encoded))
+	}
+	cache.mu.Lock()
+	if !cache.closed {
+		base := snapshotTreeCacheSlot(id)
+		for offset := range snapshotTreeCacheWays {
+			entry := cache.entries[base+offset]
+			if entry == nil || entry.id != id {
+				continue
+			}
+			if counters != nil {
+				counters.hits.Add(1)
+			}
+			cache.clock++
+			entry.lastUse = cache.clock
+			entry.readers++
+			cache.readers++
+			cache.mu.Unlock()
+			release := sync.OnceFunc(func() { cache.unpin(entry) })
+			tree, err := data.NewTreeNodeIterator(bytes.NewReader(entry.encoded))
+			if err != nil {
+				release()
+				return nil, err
+			}
+			return func(yield func(data.NodeOrError) bool) {
+				defer release()
+				tree(yield)
+			}, nil
+		}
+	}
+	cache.mu.Unlock()
+	if counters != nil {
+		counters.misses.Add(1)
+	}
+	encoded, err := loadSnapshotMechanismBlob(ctx, loader, id, counters)
+	if err != nil {
+		return nil, err
+	}
+	tree, err := data.NewTreeNodeIterator(bytes.NewReader(encoded))
+	if err == nil && ctx.Err() == nil {
+		cache.retain(id, encoded)
+	}
+	return tree, err
+}
+
+func (cache *snapshotTreeCache) retain(id vaultic.ID, encoded []byte) {
+	if len(encoded) > snapshotTreeCacheMaxTreeSize {
+		if cache.probe != nil {
+			cache.probe.oversized.Add(1)
+		}
+		return
+	}
+	charge := 2*uint64(len(encoded)) + 256
+	cache.mu.Lock()
+	defer cache.mu.Unlock()
+	if cache.closed {
+		return
+	}
+	base := snapshotTreeCacheSlot(id)
+	slot, victim := -1, -1
+	for offset := range snapshotTreeCacheWays {
+		candidate := base + offset
+		entry := cache.entries[candidate]
+		if entry == nil {
+			if slot < 0 {
+				slot = candidate
+			}
+			continue
+		}
+		if entry.id == id {
+			return
+		}
+		if entry.readers == 0 && (victim < 0 || entry.lastUse < cache.entries[victim].lastUse) {
+			victim = candidate
+		}
+	}
+	if slot < 0 {
+		slot = victim
+	}
+	if slot < 0 {
+		if cache.probe != nil {
+			cache.probe.pinnedRejects.Add(1)
+		}
+		return
+	}
+	if entry := cache.entries[slot]; entry != nil {
+		if cache.probe != nil {
+			cache.probe.collisions.Add(1)
+		}
+		cache.used -= entry.charge
+		cache.entries[slot] = nil
+	}
+	for scanned := 0; cache.used+charge > snapshotTreeCacheBytes-snapshotTreeCacheBookkeeping; scanned++ {
+		if scanned == len(cache.entries) {
+			return
+		}
+		entry := cache.entries[cache.oldest]
+		if entry != nil && entry.readers == 0 {
+			if cache.probe != nil {
+				cache.probe.capacityEvicts.Add(1)
+			}
+			cache.used -= entry.charge
+			cache.entries[cache.oldest] = nil
+		}
+		cache.oldest = (cache.oldest + 1) % len(cache.entries)
+	}
+	cache.clock++
+	cache.entries[slot] = &snapshotTreeCacheEntry{id: id, encoded: bytes.Clone(encoded), charge: charge, lastUse: cache.clock}
+	cache.used += charge
+	if cache.probe != nil {
+		cache.probe.retains.Add(1)
+		updateSnapshotMechanismMax(&cache.probe.cachePeak, cache.used)
+	}
+}
+
+func (cache *snapshotTreeCache) unpin(entry *snapshotTreeCacheEntry) {
+	cache.mu.Lock()
+	defer cache.mu.Unlock()
+	entry.readers--
+	cache.readers--
+	cache.finishLocked()
+}
+
+func (cache *snapshotTreeCache) finishLocked() {
+	if cache.closed && cache.readers == 0 {
+		clear(cache.entries)
+		cache.entries = nil
+		cache.used = 0
+		cache.release()
+	}
+}
+
+func (cache *snapshotTreeCache) close() {
+	if cache == nil {
+		return
+	}
+	cache.mu.Lock()
+	defer cache.mu.Unlock()
+	cache.closed = true
+	cache.finishLocked()
+}
diff --git a/internal/index/legacyimport/snapshot_diagnostic.go b/internal/index/legacyimport/snapshot_diagnostic.go
