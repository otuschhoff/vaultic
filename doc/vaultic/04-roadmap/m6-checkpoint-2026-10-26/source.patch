+func TestM6SnapshotMechanismAdmissionAndRelease(t *testing.T) {
+	t.Setenv("VAULTIC_M6_SNAPSHOT_MECHANISM_DIR", "")
+	if ctx, stop, err := startSnapshotMechanism(t.Context()); err != nil || stop != nil || ctx != t.Context() {
+		t.Fatalf("disabled probe: stop=%t err=%v", stop != nil, err)
+	}
+	directory := t.TempDir()
+	if err := os.Chmod(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("VAULTIC_M6_SNAPSHOT_MECHANISM_DIR", directory)
+	if _, stop, err := startSnapshotMechanism(t.Context()); err == nil || stop != nil {
+		t.Fatal("unaccounted probe admitted")
+	}
+	denied, err := workingkv.NewPolicy(workingkv.ModeRAM, snapshotMechanismCharge-1, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, stop, err := startSnapshotMechanism(workingkv.WithPolicy(t.Context(), denied)); err == nil || stop != nil || denied.Budget().Used != 0 {
+		t.Fatal("denied probe retained charge", err, denied.Budget())
+	}
+	policy, err := workingkv.NewPolicy(workingkv.ModeRAM, 2*snapshotMechanismCharge, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := workingkv.WithPolicy(t.Context(), policy)
+	if err := os.Chmod(directory, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if _, stop, err := startSnapshotMechanism(ctx); err == nil || stop != nil || policy.Budget().Used != 0 {
+		t.Fatal("insecure probe directory admitted", err)
+	}
+	if err := os.Chmod(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	cancelled, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, stop, err := startSnapshotMechanism(cancelled); !errors.Is(err, context.Canceled) || stop != nil || policy.Budget().Used != 0 {
+		t.Fatal("cancelled probe admitted", err)
+	}
+	probed, stop, err := startSnapshotMechanism(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stop() })
+	if policy.Budget().Used != snapshotMechanismCharge || snapshotMechanismFrom(probed) == nil {
+		t.Fatal("probe charge/context missing", policy.Budget())
+	}
+	snapshotMechanismFrom(probed).hits.Add(7)
+	for range 2 {
+		if err := stop(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if policy.Budget().Used != 0 {
+		t.Fatal("probe charge leaked", policy.Budget())
+	}
+	filename := filepath.Join(directory, "snapshot-mechanism.jsonl")
+	before, err := os.ReadFile(filename)
+	if err != nil || !bytes.Contains(before, []byte(`"hits":7`)) {
+		t.Fatal("probe final counters missing", err)
+	}
+	if info, err := os.Stat(filename); err != nil || info.Mode().Perm() != 0600 {
+		t.Fatal("probe artifact permissions", err)
+	}
+	if _, stop, err := startSnapshotMechanism(ctx); err == nil || stop != nil || policy.Budget().Used != 0 {
+		t.Fatal("probe overwrote previous evidence", err)
+	}
+	after, err := os.ReadFile(filename)
+	if err != nil || !bytes.Equal(before, after) {
+		t.Fatal("failed admission changed evidence", err)
+	}
+}
