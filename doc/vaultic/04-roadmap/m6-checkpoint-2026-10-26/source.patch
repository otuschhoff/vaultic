index 0000000..4286a07
--- /dev/null
+++ b/internal/index/legacyimport/snapshot_diagnostic.go
@@ -0,0 +1,83 @@
+package legacyimport
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime/pprof"
+	"sync"
+	"time"
+
+	"github.com/otuschhoff/vaultic/internal/workingstate"
+)
+
+const snapshotDiagnosticCharge = 32 << 20
+
+func startSnapshotDiagnosticProfile(ctx context.Context, ordinal uint64) (func(), error) {
+	directory := os.Getenv("VAULTIC_M6_SNAPSHOT_PROFILE_DIR")
+	if directory == "" || (ordinal != 1 && ordinal != 29) {
+		return nil, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if workingstate.PolicyFrom(ctx) == nil {
+		return nil, fmt.Errorf("snapshot profiling requires an accounted working policy")
+	}
+	info, err := os.Lstat(directory)
+	if err != nil || !info.IsDir() || info.Mode().Perm() != 0700 {
+		return nil, fmt.Errorf("snapshot profiling requires a private directory")
+	}
+	release, err := workingstate.Reserve(ctx, snapshotDiagnosticCharge)
+	if err != nil {
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		release()
+		return nil, err
+	}
+	base := filepath.Join(directory, fmt.Sprintf("snapshot-%02d", ordinal))
+	file, err := os.OpenFile(base+".cpu.pprof", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		release()
+		return nil, err
+	}
+	if err := pprof.StartCPUProfile(file); err != nil {
+		_ = file.Close()
+		release()
+		return nil, err
+	}
+	started := time.Now()
+	marker, err := json.Marshal(map[string]any{
+		"schema": "m6-snapshot-profile-window-v1", "snapshot_ordinal": ordinal,
+		"cli_pid": os.Getpid(), "started_unix_ms": started.UnixMilli(),
+		"maximum_seconds": 600, "managed_charge": snapshotDiagnosticCharge,
+	})
+	if err == nil {
+		err = os.WriteFile(base+".started.json", marker, 0600)
+	}
+	if err != nil {
+		pprof.StopCPUProfile()
+		_ = file.Close()
+		release()
+		return nil, err
+	}
+	stop := sync.OnceFunc(func() {
+		pprof.StopCPUProfile()
+		syncErr := file.Sync()
+		closeErr := file.Close()
+		release()
+		finished, marshalErr := json.Marshal(map[string]any{
+			"schema": "m6-snapshot-profile-window-v1", "snapshot_ordinal": ordinal,
+			"finished_unix_ms": time.Now().UnixMilli(), "wall_seconds": time.Since(started).Seconds(),
+			"file_sync_ok": syncErr == nil, "file_close_ok": closeErr == nil,
+		})
+		if marshalErr == nil {
+			_ = os.WriteFile(base+".finished.json", finished, 0600)
+		}
+	})
+	timer := time.AfterFunc(10*time.Minute, stop)
+	return func() { timer.Stop(); stop() }, nil
+}
diff --git a/internal/index/legacyimport/snapshot_mechanism.go b/internal/index/legacyimport/snapshot_mechanism.go
new file mode 100644
index 0000000..3259e2e
--- /dev/null
+++ b/internal/index/legacyimport/snapshot_mechanism.go
@@ -0,0 +1,170 @@
+package legacyimport
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/otuschhoff/vaultic/internal/vaultic"
+	"github.com/otuschhoff/vaultic/internal/workingstate"
+)
+
+const snapshotMechanismCharge = 1 << 20
+
+type snapshotMechanismContextKey struct{}
+
+type snapshotMechanismCounters struct {
+	ordinal        atomic.Uint64
+	requests       atomic.Uint64
+	hits           atomic.Uint64
+	misses         atomic.Uint64
+	bypasses       atomic.Uint64
+	backendCalls   atomic.Uint64
+	backendBytes   atomic.Uint64
+	backendErrors  atomic.Uint64
+	backendNanos   atomic.Uint64
+	backendMax     atomic.Uint64
+	retains        atomic.Uint64
+	oversized      atomic.Uint64
+	pinnedRejects  atomic.Uint64
+	collisions     atomic.Uint64
+	capacityEvicts atomic.Uint64
+	cachePeak      atomic.Uint64
+	debtCalls      atomic.Uint64
+	debtPuts       atomic.Uint64
+	debtBytes      atomic.Uint64
+	debtNanos      atomic.Uint64
+	debtMax        atomic.Uint64
+	debtErrors     atomic.Uint64
+	durableCalls   atomic.Uint64
+}
+
+func startSnapshotMechanism(ctx context.Context) (context.Context, func() error, error) {
+	directory := os.Getenv("VAULTIC_M6_SNAPSHOT_MECHANISM_DIR")
+	if directory == "" {
+		return ctx, nil, nil
+	}
+	if err := ctx.Err(); err != nil {
+		return ctx, nil, err
+	}
+	if _, accounted := workingstate.PolicyFrom(ctx).(interface {
+		Reserve(uint64) error
+		Release(uint64)
+	}); !accounted {
+		return ctx, nil, fmt.Errorf("snapshot mechanism probe requires an accounted policy")
+	}
+	info, err := os.Lstat(directory)
+	if err != nil || !info.IsDir() || info.Mode().Perm() != 0700 {
+		return ctx, nil, fmt.Errorf("snapshot mechanism probe requires a private directory")
+	}
+	release, err := workingstate.Reserve(ctx, snapshotMechanismCharge)
+	if err != nil {
+		return ctx, nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		release()
+		return ctx, nil, err
+	}
+	file, err := os.OpenFile(filepath.Join(directory, "snapshot-mechanism.jsonl"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		release()
+		return ctx, nil, err
+	}
+	counters := &snapshotMechanismCounters{}
+	encoder := json.NewEncoder(file)
+	write := func(reason string) error {
+		return encoder.Encode(map[string]any{
+			"schema": "m6-snapshot-mechanism-v1", "cli_pid": os.Getpid(),
+			"unix_ms": time.Now().UnixMilli(), "reason": reason,
+			"managed_charge_bytes": snapshotMechanismCharge, "counters": counters.values(),
+		})
+	}
+	if err := write("started"); err != nil {
+		_ = file.Close()
+		release()
+		return ctx, nil, err
+	}
+	stop := make(chan struct{})
+	finished := make(chan struct{})
+	var finishErr error
+	go func() {
+		defer close(finished)
+		defer release()
+		ticker := time.NewTicker(15 * time.Second)
+		defer ticker.Stop()
+		var writeErr error
+		for {
+			select {
+			case <-ticker.C:
+				if writeErr == nil {
+					writeErr = write("periodic")
+				}
+			case <-stop:
+				finishErr = errors.Join(writeErr, write("finished"), file.Sync(), file.Close())
+				return
+			}
+		}
+	}()
+	closeStop := sync.OnceFunc(func() { close(stop) })
+	return context.WithValue(ctx, snapshotMechanismContextKey{}, counters), func() error {
+		closeStop()
+		<-finished
+		return finishErr
+	}, nil
+}
+
+func snapshotMechanismFrom(ctx context.Context) *snapshotMechanismCounters {
+	counters, _ := ctx.Value(snapshotMechanismContextKey{}).(*snapshotMechanismCounters)
+	return counters
+}
+
+func updateSnapshotMechanismMax(maximum *atomic.Uint64, value uint64) {
+	for previous := maximum.Load(); value > previous; previous = maximum.Load() {
+		if maximum.CompareAndSwap(previous, value) {
+			return
+		}
+	}
+}
+
+func loadSnapshotMechanismBlob(ctx context.Context, loader vaultic.BlobLoader, id vaultic.ID, counters *snapshotMechanismCounters) ([]byte, error) {
+	if counters == nil {
+		return loader.LoadBlob(ctx, vaultic.BlobHandle{Type: vaultic.TreeBlob, ID: id}, nil)
+	}
+	started := time.Now()
+	encoded, err := loader.LoadBlob(ctx, vaultic.BlobHandle{Type: vaultic.TreeBlob, ID: id}, nil)
+	if counters != nil {
+		elapsed := uint64(time.Since(started))
+		counters.backendCalls.Add(1)
+		counters.backendBytes.Add(uint64(len(encoded)))
+		counters.backendNanos.Add(elapsed)
+		updateSnapshotMechanismMax(&counters.backendMax, elapsed)
+		if err != nil {
+			counters.backendErrors.Add(1)
+		}
+	}
+	return encoded, err
+}
+
+func (counters *snapshotMechanismCounters) values() map[string]uint64 {
+	return map[string]uint64{
+		"snapshot_ordinal": counters.ordinal.Load(),
+		"requests":         counters.requests.Load(), "hits": counters.hits.Load(),
+		"misses": counters.misses.Load(), "bypasses": counters.bypasses.Load(),
+		"backend_calls": counters.backendCalls.Load(), "backend_bytes": counters.backendBytes.Load(),
+		"backend_errors": counters.backendErrors.Load(), "backend_nanoseconds": counters.backendNanos.Load(),
+		"backend_max_nanoseconds": counters.backendMax.Load(), "retains": counters.retains.Load(),
+		"oversized_rejects": counters.oversized.Load(), "pinned_rejects": counters.pinnedRejects.Load(),
+		"collision_evictions": counters.collisions.Load(), "capacity_evictions": counters.capacityEvicts.Load(),
+		"cache_peak_charge_bytes": counters.cachePeak.Load(),
+		"debt_calls":              counters.debtCalls.Load(), "debt_puts": counters.debtPuts.Load(),
+		"debt_bytes": counters.debtBytes.Load(), "debt_nanoseconds": counters.debtNanos.Load(),
+		"debt_max_nanoseconds": counters.debtMax.Load(), "debt_errors": counters.debtErrors.Load(),
+		"debt_durable_calls": counters.durableCalls.Load(),
+	}
+}
diff --git a/internal/index/legacyimport/snapshot_equal_work_test.go b/internal/index/legacyimport/snapshot_equal_work_test.go
new file mode 100644
index 0000000..df6e2d1
--- /dev/null
+++ b/internal/index/legacyimport/snapshot_equal_work_test.go
@@ -0,0 +1,472 @@
+package legacyimport
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/otuschhoff/vaultic/internal/backend/cache"
+	"github.com/otuschhoff/vaultic/internal/backend/local"
+	"github.com/otuschhoff/vaultic/internal/data"
+	"github.com/otuschhoff/vaultic/internal/index/daemon"
+	"github.com/otuschhoff/vaultic/internal/index/schema"
+	"github.com/otuschhoff/vaultic/internal/repository"
+	"github.com/otuschhoff/vaultic/internal/vaultic"
+	"github.com/otuschhoff/vaultic/internal/workingkv"
+)
+
+type m6EqualTree struct {
+	id      vaultic.ID
+	encoded []byte
+}
+
+func m6EqualEvent(t *testing.T, event map[string]any) {
+	t.Helper()
+	event["captured_unix_ms"] = time.Now().UnixMilli()
+	event["pid"] = os.Getpid()
+	encoded, err := json.Marshal(event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("M6_EQUAL_WORK %s", encoded)
+}
+
+func m6EqualCorpus(ctx context.Context, source vaultic.BlobLoader, roots vaultic.IDs) ([]m6EqualTree, error) {
+	queue := slices.Clone(roots)
+	slices.SortFunc(queue, func(first, second vaultic.ID) int { return bytes.Compare(first[:], second[:]) })
+	seen := make(map[vaultic.ID]bool)
+	var corpus []m6EqualTree
+	var retained int
+	var retainedNodes int
+	for len(queue) != 0 && len(corpus) < 512 && retained < 64<<20 {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		id := queue[0]
+		queue = queue[1:]
+		if seen[id] {
+			continue
+		}
+		seen[id] = true
+		encoded, err := source.LoadBlob(ctx, vaultic.BlobHandle{ID: id, Type: vaultic.TreeBlob}, nil)
+		if err != nil || vaultic.Hash(encoded) != id {
+			return nil, fmt.Errorf("equal-work corpus load/hash failure: %v", err)
+		}
+		if len(encoded) > 64<<20-retained {
+			break
+		}
+		iterator, err := data.NewTreeNodeIterator(bytes.NewReader(encoded))
+		if err != nil {
+			return nil, err
+		}
+		var children vaultic.IDs
+		var treeNodes int
+		for item := range iterator {
+			if item.Error != nil {
+				return nil, item.Error
+			}
+			treeNodes++
+			if item.Node.Subtree != nil && !seen[*item.Node.Subtree] && len(children) < 4096 {
+				children = append(children, *item.Node.Subtree)
+			}
+		}
+		if retainedNodes+treeNodes > 50000 {
+			break
+		}
+		slices.SortFunc(children, func(first, second vaultic.ID) int { return bytes.Compare(first[:], second[:]) })
+		if len(queue) < 8192 {
+			queue = append(queue, children[:min(len(children), 8192-len(queue))]...)
+		}
+		corpus = append(corpus, m6EqualTree{id: id, encoded: bytes.Clone(encoded)})
+		retained += len(encoded)
+		retainedNodes += treeNodes
+	}
+	if len(corpus) == 0 {
+		return nil, errors.New("equal-work corpus is empty")
+	}
+	return corpus, nil
+}
+
+func m6EqualDecode(corpus []m6EqualTree, snapshot vaultic.ID) ([32]byte, uint64, []daemon.Mutation, error) {
+	hash := sha256.New()
+	var nodes uint64
+	var mutations []daemon.Mutation
+	for _, tree := range corpus {
+		iterator, err := data.NewTreeNodeIterator(bytes.NewReader(tree.encoded))
+		if err != nil {
+			return [32]byte{}, 0, nil, err
+		}
+		for item := range iterator {
+			if item.Error != nil {
+				return [32]byte{}, 0, nil, item.Error
+			}
+			encoded, err := json.Marshal(item.Node)
+			if err != nil {
+				return [32]byte{}, 0, nil, err
+			}
+			var length [8]byte
+			binary.BigEndian.PutUint64(length[:], uint64(len(encoded)))
+			hash.Write(length[:])
+			hash.Write(encoded)
+			nodes++
+			for _, reason := range []schema.DebtReason{schema.DebtMissingInode, schema.DebtUnknownFreshness} {
+				mutation, err := debtMutation(debtWrite{
+					snapshot: snapshot, work: tree.id,
+					pathHint: fmt.Sprintf("%s/%d/%s", tree.id.String(), nodes, item.Node.Name), reason: reason,
+				})
+				if err != nil {
+					return [32]byte{}, 0, nil, err
+				}
+				mutations = append(mutations, mutation)
+			}
+		}
+	}
+	var digest [32]byte
+	copy(digest[:], hash.Sum(nil))
+	return digest, nodes, mutations, nil
+}
+
+func m6EqualPipeline(ctx context.Context, source vaultic.BlobLoader, corpus []m6EqualTree, store TreeStore, snapshot vaultic.ID) ([32]byte, uint64, []daemon.Mutation, error) {
+	hash := sha256.New()
+	var nodes uint64
+	var verify []daemon.Mutation
+	var batch []daemon.Mutation
+	var batchBytes uint64
+	flush := func() error {
+		if len(batch) == 0 {
+			return nil
+		}
+		if err := store.WriteMutableBatch(ctx, batch, nil, false); err != nil {
+			return err
+		}
+		batch = batch[:0]
+		batchBytes = 0
+		return nil
+	}
+	for _, tree := range corpus {
+		if err := ctx.Err(); err != nil {
+			return [32]byte{}, 0, nil, err
+		}
+		encoded, err := source.LoadBlob(ctx, vaultic.BlobHandle{ID: tree.id, Type: vaultic.TreeBlob}, nil)
+		if err != nil || !bytes.Equal(encoded, tree.encoded) {
+			return [32]byte{}, 0, nil, fmt.Errorf("pipeline plaintext mismatch: %v", err)
+		}
+		iterator, err := data.NewTreeNodeIterator(bytes.NewReader(encoded))
+		if err != nil {
+			return [32]byte{}, 0, nil, err
+		}
+		for item := range iterator {
+			if item.Error != nil {
+				return [32]byte{}, 0, nil, item.Error
+			}
+			encoded, err := json.Marshal(item.Node)
+			if err != nil {
+				return [32]byte{}, 0, nil, err
+			}
+			var length [8]byte
+			binary.BigEndian.PutUint64(length[:], uint64(len(encoded)))
+			hash.Write(length[:])
+			hash.Write(encoded)
+			nodes++
+			for _, reason := range []schema.DebtReason{schema.DebtMissingInode, schema.DebtUnknownFreshness} {
+				mutation, err := debtMutation(debtWrite{snapshot: snapshot, work: tree.id,
+					pathHint: fmt.Sprintf("%s/%d/%s", tree.id.String(), nodes, item.Node.Name), reason: reason})
+				if err != nil {
+					return [32]byte{}, 0, nil, err
+				}
+				size := uint64(len(mutation.Key) + len(mutation.Value))
+				if len(batch) != 0 && (len(batch) >= 4096 || batchBytes+size > 1<<20) {
+					if err := flush(); err != nil {
+						return [32]byte{}, 0, nil, err
+					}
+				}
+				if len(verify) < 2 {
+					verify = append(verify, mutation)
+				}
+				batch = append(batch, mutation)
+				batchBytes += size
+			}
+		}
+	}
+	if len(batch) != 0 {
+		verify = append(verify, batch[len(batch)-1])
+	}
+	if err := flush(); err != nil {
+		return [32]byte{}, 0, nil, err
+	}
+	var digest [32]byte
+	copy(digest[:], hash.Sum(nil))
+	return digest, nodes, verify, nil
+}
+
+func TestM6EqualWorkCorpusDeterminism(t *testing.T) {
+	child := treeJSON(t, &data.Node{Name: "child-file", Type: data.NodeTypeFile})
+	childID := vaultic.Hash(child)
+	root := treeJSON(t, &data.Node{Name: "directory", Type: data.NodeTypeDir, Subtree: &childID})
+	rootID := vaultic.Hash(root)
+	source := &memorySource{blobs: map[vaultic.ID][]byte{rootID: root, childID: child}}
+	corpus, err := m6EqualCorpus(t.Context(), source, vaultic.IDs{rootID, rootID})
+	if err != nil || len(corpus) != 2 {
+		t.Fatalf("corpus=%d err=%v", len(corpus), err)
+	}
+	snapshot := vaultic.Hash([]byte("deterministic-snapshot"))
+	first, nodes, mutations, err := m6EqualDecode(corpus, snapshot)
+	second, repeatedNodes, repeatedMutations, repeatedErr := m6EqualDecode(corpus, snapshot)
+	if err != nil || repeatedErr != nil || nodes != 2 || repeatedNodes != nodes || first != second || len(mutations) != 4 || !slices.EqualFunc(mutations, repeatedMutations, func(first, second daemon.Mutation) bool {
+		return bytes.Equal(first.Key, second.Key) && bytes.Equal(first.Value, second.Value)
+	}) {
+		t.Fatal("equal-work replay changed facts", err, repeatedErr)
+	}
+	store := newMemoryStore()
+	pipelineDigest, pipelineNodes, _, err := m6EqualPipeline(t.Context(), source, corpus, store, snapshot)
+	if err != nil || pipelineDigest != first || pipelineNodes != nodes || len(store.values) != len(mutations) {
+		t.Fatal("pipeline changed decoder facts", err)
+	}
+	for _, mutation := range mutations {
+		if !bytes.Equal(store.values[string(mutation.Key)], mutation.Value) {
+			t.Fatal("pipeline changed exact debt bytes")
+		}
+	}
+	canceled, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, err := m6EqualCorpus(canceled, source, vaultic.IDs{rootID}); !errors.Is(err, context.Canceled) {
+		t.Fatal("corpus ignored cancellation", err)
+	}
+}
+
+func TestM6FullCatalogEqualWorkDiagnostic(t *testing.T) {
+	if os.Getenv("VAULTIC_M6_EQUAL_WORK") != "1" {
+		t.Skip("opt-in fresh full-catalog component diagnostic, not acceptance")
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 12*time.Hour)
+	defer cancel()
+	directory := os.Getenv("VAULTIC_M6_DIAGNOSTIC_STATE")
+	if directory == "" || os.Getenv("VAULTICDB_TEST_BINARY") == "" {
+		t.Fatal("private fresh state and pinned native binary are required")
+	}
+	if _, err := os.Stat(filepath.Join(directory, "db")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("equal-work diagnostic refuses existing native state")
+	}
+	policy, err := workingkv.NewPolicy(workingkv.ModeRAM, 160<<30, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx = workingkv.WithPolicy(ctx, policy)
+	if err := policy.Reserve(1 << 30); err != nil {
+		t.Fatal(err)
+	}
+	defer policy.Release(1 << 30)
+	password, err := os.ReadFile(os.Getenv("VAULTIC_M6_DIAGNOSTIC_PASSWORD_FILE"))
+	if err != nil {
+		t.Fatal("equal-work password unavailable")
+	}
+	backend, err := local.Open(ctx, local.Config{Path: os.Getenv("VAULTIC_M6_DIAGNOSTIC_REPO"), Connections: 8}, func(string, ...any) {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer backend.Close()
+	repo, err := repository.New(backend, repository.Options{Compression: repository.CompressionFastest})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer repo.Close()
+	if err := repo.SearchKey(ctx, strings.TrimRight(string(password), "\r\n"), 10, ""); err != nil {
+		t.Fatal("equal-work source unlock failed")
+	}
+	fileCache, err := cache.New(repo.Config().ID, filepath.Join(directory, "cache"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	repo.UseCache(fileCache, func(string, ...any) {})
+	started := time.Now()
+	if err := repo.LoadIndex(ctx, vaultic.NoopTerminalCounterFactory); err != nil {
+		t.Fatal("equal-work complete source preload failed", err)
+	}
+	m6EqualEvent(t, map[string]any{"stage": "source_preload", "elapsed_ns": time.Since(started).Nanoseconds()})
+	nativeOptions := daemon.Options{
+		Socket: filepath.Join(directory, "d.sock"), RepositoryID: "m6-equal-work-full-catalog",
+		DaemonPath: os.Getenv("VAULTICDB_TEST_BINARY"), DataDir: filepath.Join(directory, "db"), ObjectStore: "local",
+		WALStore: "memory", WALDataDir: filepath.Join(directory, "wal"), RebuildReset: true, FreshBulkImport: true,
+	}
+	client, err := daemon.Ensure(ctx, nativeOptions)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close(context.Background())
+	store := daemon.NewSchemaStore(client)
+	store.EnableFreshLegacyImportContext(ctx)
+	defer store.ReleaseFreshLegacyImport()
+	started = time.Now()
+	result, err := Import(ctx, repo, repo.Backend(), store, Options{PublicationLanes: 2, Telemetry: NewSchedulerTelemetry(), Progress: func(progress Progress) {
+		if progress.IndexesCompleted%100 == 0 {
+			m6EqualEvent(t, map[string]any{"stage": "catalog_progress", "indexes": progress.IndexesCompleted, "total": progress.IndexesTotal, "blobs": progress.BlobsImported})
+		}
+	}})
+	if err != nil || result.ErrorsSeen != 0 || result.IndexesImported != 10170 || result.PacksImported != 419853 || result.BlobsImported != 380166821 {
+		t.Fatalf("equal-work full catalog not established: result=%+v err=%v", result, err)
+	}
+	m6EqualEvent(t, map[string]any{"stage": "catalog_ready", "elapsed_ns": time.Since(started).Nanoseconds(), "indexes": result.IndexesImported, "packs": result.PacksImported, "blobs": result.BlobsImported})
+	var roots vaultic.IDs
+	if err := repo.List(ctx, vaultic.SnapshotFile, func(id vaultic.ID, _ int64) error {
+		original, err := repo.LoadLegacyUnpacked(ctx, vaultic.SnapshotFile, id)
+		if err != nil {
+			return err
+		}
+		var snapshot data.Snapshot
+		if err := json.Unmarshal(original, &snapshot); err != nil {
+			return err
+		}
+		if snapshot.Tree == nil {
+			return errors.New("equal-work snapshot lacks root")
+		}
+		roots = append(roots, *snapshot.Tree)
+		return nil
+	}); err != nil || len(roots) != 143 {
+		t.Fatal("equal-work complete snapshot inventory unavailable", err, len(roots))
+	}
+	corpus, err := m6EqualCorpus(ctx, repo, roots)
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected, expectedNodes, _, err := m6EqualDecode(corpus, vaultic.Hash([]byte("initial-fact-digest")))
+	if err != nil {
+		t.Fatal(err)
+	}
+	measureCtx, cancelMeasure := context.WithTimeout(ctx, 30*time.Minute)
+	defer cancelMeasure()
+	var verifyMutations []daemon.Mutation
+	for round := range 5 {
+		order := []bool{false, true}
+		if round%2 == 1 {
+			slices.Reverse(order)
+		}
+		for _, pooled := range order {
+			readCtx := measureCtx
+			var session *cache.PackReadSession
+			if pooled {
+				readCtx, session = cache.WithPackReadSession(measureCtx, 64)
+				if session == nil {
+					t.Fatal("equal-work candidate reader reservation denied")
+				}
+			}
+			started = time.Now()
+			var encodedBytes uint64
+			for range 3 {
+				for _, tree := range corpus {
+					encoded, err := repo.LoadBlob(readCtx, vaultic.BlobHandle{ID: tree.id, Type: vaultic.TreeBlob}, nil)
+					if err != nil || !bytes.Equal(encoded, tree.encoded) {
+						session.Close()
+						t.Fatal("equal-work loader changed plaintext", err)
+					}
+					encodedBytes += uint64(len(encoded))
+				}
+			}
+			elapsed := time.Since(started)
+			if err := session.Close(); err != nil {
+				t.Fatal(err)
+			}
+			m6EqualEvent(t, map[string]any{"stage": "loader", "round": round, "pooled": pooled, "items": len(corpus) * 3, "bytes": encodedBytes, "elapsed_ns": elapsed.Nanoseconds()})
+		}
+		started = time.Now()
+		var decodedNodes uint64
+		for _, tree := range corpus {
+			iterator, err := data.NewTreeNodeIterator(bytes.NewReader(tree.encoded))
+			if err != nil {
+				t.Fatal(err)
+			}
+			for item := range iterator {
+				if item.Error != nil {
+					t.Fatal(item.Error)
+				}
+				decodedNodes++
+			}
+		}
+		if decodedNodes != expectedNodes {
+			t.Fatal("equal-work decoder changed node count")
+		}
+		m6EqualEvent(t, map[string]any{"stage": "decode", "round": round, "nodes": decodedNodes, "elapsed_ns": time.Since(started).Nanoseconds()})
+		started = time.Now()
+		digest, nodes, mutations, err := m6EqualDecode(corpus, vaultic.Hash([]byte(fmt.Sprintf("m6-equal-work-round-%d", round))))
+		if err != nil || digest != expected || nodes != expectedNodes || len(mutations) == 0 {
+			t.Fatal("equal-work decode changed node facts", err)
+		}
+		m6EqualEvent(t, map[string]any{"stage": "fact_validation_and_encoding", "round": round, "nodes": nodes, "elapsed_ns": time.Since(started).Nanoseconds(), "fact_sha256": fmt.Sprintf("%x", digest)})
+		verifyMutations = append(verifyMutations, mutations[0], mutations[len(mutations)/2], mutations[len(mutations)-1])
+		started = time.Now()
+		var mutationBytes uint64
+		for _, mutation := range mutations {
+			mutationBytes += uint64(len(mutation.Key) + len(mutation.Value))
+		}
+		for first := 0; first < len(mutations); {
+			last, encoded := first, uint64(0)
+			for last < len(mutations) && last-first < 4096 {
+				size := uint64(len(mutations[last].Key) + len(mutations[last].Value))
+				if last > first && encoded+size > 1<<20 {
+					break
+				}
+				encoded += size
+				last++
+			}
+			if err := store.WriteMutableBatch(measureCtx, mutations[first:last], nil, false); err != nil {
+				t.Fatal("equal-work native write failed", err)
+			}
+			first = last
+		}
+		m6EqualEvent(t, map[string]any{"stage": "native_write", "round": round, "puts": len(mutations), "bytes": mutationBytes, "elapsed_ns": time.Since(started).Nanoseconds()})
+		for _, pooled := range order {
+			pipelineCtx := measureCtx
+			var session *cache.PackReadSession
+			if pooled {
+				pipelineCtx, session = cache.WithPackReadSession(measureCtx, 64)
+				if session == nil {
+					t.Fatal("pipeline candidate reservation denied")
+				}
+			}
+			started = time.Now()
+			pipelineDigest, pipelineNodes, samples, pipelineErr := m6EqualPipeline(pipelineCtx, repo, corpus, store,
+				vaultic.Hash([]byte(fmt.Sprintf("m6-pipeline-%d-%t", round, pooled))))
+			elapsed := time.Since(started)
+			closeErr := session.Close()
+			if pipelineErr != nil || closeErr != nil || pipelineDigest != expected || pipelineNodes != expectedNodes {
+				t.Fatal("equal-work pipeline changed facts", pipelineErr, closeErr)
+			}
+			verifyMutations = append(verifyMutations, samples...)
+			m6EqualEvent(t, map[string]any{"stage": "pipeline", "round": round, "pooled": pooled,
+				"items": len(corpus), "nodes": pipelineNodes, "puts": pipelineNodes * 2,
+				"elapsed_ns": elapsed.Nanoseconds(), "fact_sha256": fmt.Sprintf("%x", pipelineDigest)})
+		}
+	}
+	if err := measureCtx.Err(); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.MarkBulkImportComplete(ctx); err != nil {
+		t.Fatal("equal-work catalog finalization failed", err)
+	}
+	if err := client.Close(ctx); err != nil {
+		t.Fatal(err)
+	}
+	nativeOptions.WALStore, nativeOptions.RebuildReset, nativeOptions.FreshBulkImport = "local", false, false
+	reopened, err := daemon.Ensure(ctx, nativeOptions)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.Close(context.Background())
+	for _, mutation := range verifyMutations {
+		value, found, err := daemon.NewSchemaStore(reopened).Get(ctx, mutation.Key)
+		if err != nil || !found || !bytes.Equal(value, mutation.Value) {
+			t.Fatal("equal-work native debt bytes changed across reopen", err)
+		}
+	}
+	m6EqualEvent(t, map[string]any{"stage": "finished", "diagnostic_only": true, "full_native_catalog": true,
+		"acceptance": false, "reopened_exact_samples": len(verifyMutations), "managed_budget": policy.Budget()})
+}
