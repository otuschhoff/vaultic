+func BenchmarkM6CacheRangeRead(b *testing.B) {
+	directory := b.TempDir()
+	if parent := os.Getenv("VAULTIC_M6_CACHE_BENCH_DIR"); parent != "" {
+		var err error
+		directory, err = os.MkdirTemp(parent, "range-read-")
+		if err != nil {
+			b.Fatal(err)
+		}
+		defer os.RemoveAll(directory)
+	}
+	cache, err := New(testCacheID, directory)
+	if err != nil {
+		b.Fatal(err)
+	}
+	data := bytes.Repeat([]byte("range-read-content"), 1<<16)
+	handle := backend.Handle{Type: backend.PackFile, Name: vaultic.Hash(data).String()}
+	if err := cache.save(handle, bytes.NewReader(data)); err != nil {
+		b.Fatal(err)
+	}
+	for _, name := range []string{"seek", "read_at", "reuse_fd", "session"} {
+		b.Run(name, func(b *testing.B) {
+			policy, err := workingkv.NewPolicy(workingkv.ModeRAM, 1<<20, "")
+			if err != nil {
+				b.Fatal(err)
+			}
+			ctx, session := WithPackReadSession(workingkv.WithPolicy(b.Context(), policy), 64)
+			defer session.Close()
+			buffer := make([]byte, 4096)
+			shared, err := os.Open(cache.filename(handle))
+			if err != nil {
+				b.Fatal(err)
+			}
+			defer shared.Close()
+			if _, err := shared.Stat(); err != nil {
+				b.Fatal(err)
+			}
+			b.SetBytes(int64(len(buffer)))
+			b.ReportAllocs()
+			for iteration := 0; iteration < b.N; iteration++ {
+				if name == "reuse_fd" {
+					_, err := shared.ReadAt(buffer, 4096)
+					if err != nil || !bytes.Equal(buffer, data[4096:8192]) {
+						b.Fatalf("shared range mismatch: %v", err)
+					}
+					continue
+				}
+				var reader io.ReadCloser
+				if name == "read_at" {
+					file, err := os.Open(cache.filename(handle))
+					if err != nil {
+						b.Fatal(err)
+					}
+					info, err := file.Stat()
+					if err != nil || info.Size() < 8192 {
+						file.Close()
+						b.Fatalf("cache bounds: %v", err)
+					}
+					reader = struct {
+						io.Reader
+						io.Closer
+					}{io.NewSectionReader(file, 4096, int64(len(buffer))), file}
+				} else {
+					var inCache bool
+					if name == "session" {
+						reader, inCache, err = cache.loadContext(ctx, handle, len(buffer), 4096)
+					} else {
+						reader, inCache, err = cache.load(handle, len(buffer), 4096)
+					}
+					if err != nil || !inCache {
+						b.Fatalf("cache load: %v", err)
+					}
+				}
+				_, readErr := io.ReadFull(reader, buffer)
+				closeErr := reader.Close()
+				if readErr != nil || closeErr != nil || !bytes.Equal(buffer, data[4096:8192]) {
+					b.Fatalf("range mismatch: read=%v close=%v", readErr, closeErr)
+				}
+			}
+		})
+	}
+}
