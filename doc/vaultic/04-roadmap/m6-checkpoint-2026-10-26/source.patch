+func TestM6PackReadSessionPinsEvictionAndConcurrentRanges(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("snapshot-scoped descriptor reuse is Linux-only")
+	}
+	policy, err := workingkv.NewPolicy(workingkv.ModeRAM, 1<<20, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, session := WithPackReadSession(workingkv.WithPolicy(t.Context(), policy), 1)
+	defer session.Close()
+	cache := TestNewCache(t)
+	data := bytes.Repeat([]byte("parallel-pack"), 1024)
+	first := backend.Handle{Type: backend.PackFile, Name: vaultic.Hash(data).String()}
+	second := backend.Handle{Type: backend.PackFile, Name: vaultic.Hash([]byte("second-pack")).String()}
+	for _, handle := range []backend.Handle{first, second} {
+		if err := cache.save(handle, bytes.NewReader(data)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	held, _, err := cache.loadContext(ctx, first, 100, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fallback, found, err := cache.loadContext(ctx, second, 100, 0)
+	if err != nil || !found || session.open != 1 {
+		t.Fatal("all-pinned fallback exceeded retention bound", err)
+	}
+	if _, pooled := fallback.(*packRangeReader); pooled {
+		t.Fatal("all-pinned entry admitted")
+	}
+	if err := fallback.Close(); err != nil {
+		t.Fatal(err)
+	}
+	group, groupCtx := errgroup.WithContext(ctx)
+	for ordinal := range 32 {
+		group.Go(func() error {
+			reader, found, err := cache.loadContext(groupCtx, first, 100, int64(ordinal))
+			if err != nil || !found {
+				return fmt.Errorf("parallel range found=%t err=%v", found, err)
+			}
+			value, readErr := io.ReadAll(reader)
+			closeErr := reader.Close()
+			if readErr != nil || closeErr != nil || !bytes.Equal(value, data[ordinal:ordinal+100]) {
+				return fmt.Errorf("parallel range mismatch read=%v close=%v", readErr, closeErr)
+			}
+			return nil
+		})
+	}
+	if err := group.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	if err := held.Close(); err != nil {
+		t.Fatal(err)
+	}
+	replacement, _, err := cache.loadContext(ctx, second, 100, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if session.entries[packReaderKey{cache: cache, name: first.Name}] != nil || session.open != 1 {
+		t.Fatal("idle LRU eviction failed")
+	}
+	if err := replacement.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := session.Close(); err != nil || policy.Budget().Used != 0 {
+		t.Fatal("eviction cleanup leaked", err, policy.Budget())
+	}
+}
