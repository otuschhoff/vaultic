+func TestM6SnapshotTreeCacheBucketPinsAndReplacement(t *testing.T) {
+	policy, err := workingkv.NewPolicy(workingkv.ModeRAM, 512<<20, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	counters := &snapshotMechanismCounters{}
+	ctx := context.WithValue(workingkv.WithPolicy(t.Context(), policy), snapshotMechanismContextKey{}, counters)
+	cache := newSnapshotTreeCache(ctx)
+	if cache == nil {
+		t.Fatal("cache admission denied")
+	}
+	defer cache.close()
+	encoded := []byte(`{"nodes":[{"name":"original","type":"file"}]}`)
+	ids := make([]vaultic.ID, snapshotTreeCacheWays+1)
+	source := &snapshotCacheTestSource{memorySource: &memorySource{blobs: make(map[vaultic.ID][]byte)}}
+	for ordinal := range ids {
+		ids[ordinal] = vaultic.Hash(encoded)
+		ids[ordinal][len(ids[ordinal])-1] ^= byte(ordinal + 1)
+		source.blobs[ids[ordinal]] = encoded
+	}
+	consume := func(tree data.TreeNodeIterator) {
+		t.Helper()
+		for item := range tree {
+			if item.Error != nil || item.Node.Name != "original" {
+				t.Fatalf("bucket replay changed: %+v", item)
+			}
+		}
+	}
+	load := func(id vaultic.ID) data.TreeNodeIterator {
+		t.Helper()
+		tree, err := cache.loadTree(ctx, source, id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return tree
+	}
+	contains := func(id vaultic.ID) bool {
+		for offset := range snapshotTreeCacheWays {
+			entry := cache.entries[snapshotTreeCacheSlot(id)+offset]
+			if entry != nil && entry.id == id {
+				return true
+			}
+		}
+		return false
+	}
+	pinned := make([]data.TreeNodeIterator, snapshotTreeCacheWays)
+	for ordinal, id := range ids[:snapshotTreeCacheWays] {
+		consume(load(id))
+		pinned[ordinal] = load(id)
+	}
+	consume(load(ids[snapshotTreeCacheWays]))
+	if counters.values()["pinned_rejects"] != 1 || contains(ids[snapshotTreeCacheWays]) {
+		t.Fatal("full pinned bucket accepted a replacement", counters.values())
+	}
+	consume(pinned[0])
+	consume(load(ids[snapshotTreeCacheWays]))
+	if contains(ids[0]) || !contains(ids[snapshotTreeCacheWays]) {
+		t.Fatal("bucket did not replace the only unpinned entry")
+	}
+	for _, tree := range pinned[1:] {
+		consume(tree)
+	}
+	consume(load(ids[1]))
+	consume(load(ids[0]))
+	if !contains(ids[1]) || contains(ids[2]) || !contains(ids[0]) {
+		t.Fatal("bucket replacement did not preserve recent use")
+	}
+	if counters.values()["collision_evictions"] != 2 || cache.used > snapshotTreeCacheBytes-snapshotTreeCacheBookkeeping {
+		t.Fatal("bucket exceeded bounded replacement accounting", counters.values(), cache.used)
+	}
+	cache.close()
+	if policy.Budget().Used != 0 {
+		t.Fatal("pinned bucket leaked charge", policy.Budget())
+	}
+}
