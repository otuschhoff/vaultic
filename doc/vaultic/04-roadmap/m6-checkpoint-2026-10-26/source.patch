+			if values["requests"] != 3 || values["hits"] != 2 || values["misses"] != 1 || values["backend_calls"] != uint64(source.loads) || values["backend_bytes"] != uint64(len(encoded)) || values["retains"] != 1 || values["backend_nanoseconds"] == 0 {
