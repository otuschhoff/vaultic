+func TestM6PackReadSession(t *testing.T) {
+	if runtime.GOOS != "linux" {
+		t.Skip("snapshot-scoped descriptor reuse is Linux-only")
+	}
+	policy, err := workingkv.NewPolicy(workingkv.ModeRAM, 1<<20, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, session := WithPackReadSession(workingkv.WithPolicy(t.Context(), policy), 2)
+	t.Cleanup(func() { session.Close() })
+	cache := TestNewCache(t)
+	data := bytes.Repeat([]byte("deterministic-pack"), 1024)
+	handle := backend.Handle{Type: backend.PackFile, Name: vaultic.Hash(data).String()}
+	if err := cache.save(handle, bytes.NewReader(data)); err != nil {
+		t.Fatal(err)
+	}
+	for iteration := range 20 {
+		reader, found, err := cache.loadContext(ctx, handle, 100, int64(iteration))
+		if err != nil || !found {
+			t.Fatalf("load found=%t err=%v", found, err)
+		}
+		value, err := io.ReadAll(reader)
+		if err != nil || !bytes.Equal(value, data[iteration:iteration+100]) {
+			t.Fatalf("range mismatch err=%v", err)
+		}
+		if err := reader.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := reader.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if session.open != 1 || policy.Budget().Used != 2*packReaderCharge {
+		t.Fatal("reader retention or accounting mismatch", session.open, policy.Budget())
+	}
+	if reader, found, err := cache.loadContext(ctx, handle, len(data)+1, 0); reader != nil || !found || err == nil {
+		t.Fatal("short cached range accepted")
+	}
+	if err := cache.Forget(handle); err != nil {
+		t.Fatal(err)
+	}
+	if reader, found, err := cache.loadContext(ctx, handle, 100, 0); reader != nil || found || err == nil {
+		t.Fatal("forgotten file reused")
+	}
+	if err := cache.save(handle, bytes.NewReader(data)); err != nil {
+		t.Fatal(err)
+	}
+	reader, found, err := cache.loadContext(ctx, handle, 100, 0)
+	if err != nil || !found {
+		t.Fatal(err)
+	}
+	if err := session.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if policy.Budget().Used == 0 {
+		t.Fatal("released active reader accounting too early")
+	}
+	if _, err := io.ReadAll(reader); err != nil {
+		t.Fatal(err)
+	}
+	if err := reader.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := session.Close(); err != nil || policy.Budget().Used != 0 || session.open != 0 {
+		t.Fatal("reader cleanup mismatch", err, policy.Budget())
+	}
+	denied, err := workingkv.NewPolicy(workingkv.ModeRAM, 1, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, session := WithPackReadSession(workingkv.WithPolicy(t.Context(), denied), 2); session != nil {
+		t.Fatal("denied reader reservation admitted")
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, session := WithPackReadSession(canceled, 2); session != nil {
+		t.Fatal("canceled reader reservation admitted")
+	}
+}
