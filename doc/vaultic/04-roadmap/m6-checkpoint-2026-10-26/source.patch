new file mode 100644
index 0000000..5ec8371
--- /dev/null
+++ b/internal/backend/cache/pack_read_session.go
@@ -0,0 +1,185 @@
+package cache
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+	"sync"
+
+	"github.com/otuschhoff/vaultic/internal/backend"
+	"github.com/otuschhoff/vaultic/internal/workingstate"
+)
+
+const packReaderCharge = 8192
+
+type packReadSessionKey struct{}
+
+type packReaderKey struct {
+	cache *Cache
+	name  string
+}
+
+type packReaderEntry struct {
+	file       *os.File
+	size       int64
+	generation uint64
+	readers    int
+	lastUse    uint64
+}
+
+type PackReadSession struct {
+	mu      sync.Mutex
+	entries map[packReaderKey]*packReaderEntry
+	limit   int
+	open    int
+	clock   uint64
+	closed  bool
+	release func()
+	err     error
+}
+
+func WithPackReadSession(ctx context.Context, limit int) (context.Context, *PackReadSession) {
+	if runtime.GOOS != "linux" || limit <= 0 || limit > 64 || ctx.Err() != nil {
+		return ctx, nil
+	}
+	if _, ok := workingstate.PolicyFrom(ctx).(interface {
+		Reserve(uint64) error
+		Release(uint64)
+	}); !ok {
+		return ctx, nil
+	}
+	if existing, _ := ctx.Value(packReadSessionKey{}).(*PackReadSession); existing != nil {
+		return ctx, nil
+	}
+	release, err := workingstate.Reserve(ctx, uint64(limit*packReaderCharge))
+	if err != nil {
+		return ctx, nil
+	}
+	if ctx.Err() != nil {
+		release()
+		return ctx, nil
+	}
+	session := &PackReadSession{limit: limit, entries: make(map[packReaderKey]*packReaderEntry, limit), release: release}
+	return context.WithValue(ctx, packReadSessionKey{}, session), session
+}
+
+func (session *PackReadSession) closeEntry(entry *packReaderEntry) error {
+	err := entry.file.Close()
+	session.err = errors.Join(session.err, err)
+	session.open--
+	if session.closed && session.open == 0 && session.release != nil {
+		session.release()
+		session.release = nil
+	}
+	return err
+}
+
+func (session *PackReadSession) Close() error {
+	if session == nil {
+		return nil
+	}
+	session.mu.Lock()
+	defer session.mu.Unlock()
+	if !session.closed {
+		session.closed = true
+		for key, entry := range session.entries {
+			delete(session.entries, key)
+			if entry.readers == 0 {
+				session.closeEntry(entry)
+			}
+		}
+		if session.open == 0 && session.release != nil {
+			session.release()
+			session.release = nil
+		}
+	}
+	return session.err
+}
+
+type packRangeReader struct {
+	*io.SectionReader
+	session *PackReadSession
+	key     packReaderKey
+	entry   *packReaderEntry
+	once    sync.Once
+	err     error
+}
+
+func (reader *packRangeReader) Close() error {
+	reader.once.Do(func() {
+		session := reader.session
+		session.mu.Lock()
+		defer session.mu.Unlock()
+		reader.entry.readers--
+		if reader.entry.readers == 0 && (session.closed || session.entries[reader.key] != reader.entry) {
+			reader.err = session.closeEntry(reader.entry)
+		}
+	})
+	return reader.err
+}
+
+func (cache *Cache) loadContext(ctx context.Context, handle backend.Handle, length int, offset int64) (io.ReadCloser, bool, error) {
+	session, _ := ctx.Value(packReadSessionKey{}).(*PackReadSession)
+	if session == nil || handle.Type != backend.PackFile || len(handle.Name) != 64 || length <= 0 || offset < 0 || int64(length) > int64(^uint64(0)>>1)-offset {
+		return cache.load(handle, length, offset)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, true, err
+	}
+	session.mu.Lock()
+	defer session.mu.Unlock()
+	if session.closed || cache == nil {
+		return cache.load(handle, length, offset)
+	}
+	key := packReaderKey{cache: cache, name: handle.Name}
+	generation := cache.generation.Load()
+	entry := session.entries[key]
+	if entry != nil && entry.generation != generation {
+		delete(session.entries, key)
+		if entry.readers == 0 {
+			if err := session.closeEntry(entry); err != nil {
+				return nil, true, err
+			}
+		}
+		entry = nil
+	}
+	if entry == nil {
+		if session.open >= session.limit {
+			var victim *packReaderEntry
+			var victimKey packReaderKey
+			for candidateKey, candidate := range session.entries {
+				if candidate.readers == 0 && (victim == nil || candidate.lastUse < victim.lastUse) {
+					victim, victimKey = candidate, candidateKey
+				}
+			}
+			if victim == nil {
+				return cache.load(handle, length, offset)
+			}
+			delete(session.entries, victimKey)
+			if err := session.closeEntry(victim); err != nil {
+				return nil, true, err
+			}
+		}
+		file, err := os.Open(cache.filename(handle))
+		if err != nil {
+			return nil, false, err
+		}
+		info, err := file.Stat()
+		if err != nil {
+			return nil, true, errors.Join(err, file.Close())
+		}
+		entry = &packReaderEntry{file: file, size: info.Size(), generation: generation}
+		session.entries[key] = entry
+		session.open++
+	}
+	if entry.size < offset+int64(length) {
+		return nil, true, fmt.Errorf("cached file %v is too short", handle)
+	}
+	session.clock++
+	entry.lastUse = session.clock
+	entry.readers++
+	return &packRangeReader{SectionReader: io.NewSectionReader(entry.file, offset, int64(length)), session: session, key: key, entry: entry}, true, nil
+}
