+func TestM6PackReadSessionFallbackAndCanceledLoad(t *testing.T) {
+	if _, session := WithPackReadSession(t.Context(), 64); session != nil {
+		t.Fatal("unaccounted session admitted")
+	}
+	policy, err := workingkv.NewPolicy(workingkv.ModeRAM, 1<<20, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := workingkv.WithPolicy(t.Context(), policy)
+	for _, limit := range []int{0, 65} {
+		if _, session := WithPackReadSession(ctx, limit); session != nil {
+			t.Fatal("invalid descriptor bound admitted")
+		}
+	}
+	if runtime.GOOS != "linux" {
+		return
+	}
+	ctx, session := WithPackReadSession(ctx, 2)
+	defer session.Close()
+	if _, nested := WithPackReadSession(ctx, 2); nested != nil {
+		t.Fatal("nested scope stole the original owner")
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	cache := TestNewCache(t)
+	handle := backend.Handle{Type: backend.PackFile, Name: vaultic.Hash([]byte("missing")).String()}
+	if reader, _, err := cache.loadContext(canceled, handle, 10, 0); reader != nil || err != context.Canceled || session.open != 0 {
+		t.Fatal("canceled load opened or retained a descriptor", err)
+	}
+	if err := session.Close(); err != nil || policy.Budget().Used != 0 {
+		t.Fatal("fallback reservation cleanup failed", err)
+	}
+}
