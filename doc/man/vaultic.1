.TH "vaultic backup" "1" "Jan 2017" "generated by \fBvaultic generate\fR" ""

.SH NAME
vaultic - Backup and restore files


.SH SYNOPSIS
\fBvaultic [flags]\fP


.SH DESCRIPTION
vaultic is a backup program which allows saving multiple revisions of files and
directories in an encrypted repository stored on different backends.

.PP
The full documentation can be found at https://vaultic.readthedocs.io/ .


.SH OPTIONS
\fB--cacert\fP=[]
	\fBfile\fR to load root certificates from (default: use system certificates or $VAULTIC_CACERT)

.PP
\fB--cache-dir\fP=""
	set the cache \fBdirectory\fR\&. (default: use system default cache directory)

.PP
\fB--cleanup-cache\fP[=false]
	auto remove old cache directories

.PP
\fB--compression\fP=auto
	compression mode (only available for repository format version 2), one of (auto|off|fastest|better|max) (default: $VAULTIC_COMPRESSION)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for vaultic

.PP
\fB--http-user-agent\fP=""
	set a http user agent for outgoing http requests

.PP
\fB--insecure-no-password\fP[=false]
	use an empty password for the repository, must be passed to every vaultic command (insecure)

.PP
\fB--insecure-tls\fP[=false]
	skip TLS certificate verification when connecting to the repository (insecure)

.PP
\fB--json\fP[=false]
	set output mode to JSON for commands that support it

.PP
\fB--key\fP=""
	master \fBkey\fR (base64-encoded JSON) to open the repository directly, bypassing password keys (default: $VAULTIC_KEY)

.PP
\fB--key-command\fP=""
	shell \fBcommand\fR to obtain the master key from (default: $VAULTIC_KEY_COMMAND)

.PP
\fB--key-file\fP=""
	\fBfile\fR containing the master key (base64-encoded JSON) to open the repository directly (default: $VAULTIC_KEY_FILE)

.PP
\fB--key-hint\fP=""
	\fBkey\fR ID of key to try decrypting first (default: $VAULTIC_KEY_HINT)

.PP
\fB--limit-download\fP=0
	limits downloads to a maximum \fBrate\fR in KiB/s. (default: unlimited)

.PP
\fB--limit-upload\fP=0
	limits uploads to a maximum \fBrate\fR in KiB/s. (default: unlimited)

.PP
\fB--no-cache\fP[=false]
	do not use a local cache

.PP
\fB--no-extra-verify\fP[=false]
	skip additional verification of data before upload (see documentation)

.PP
\fB--no-lock\fP[=false]
	do not lock the repository, this allows some operations on read-only repositories

.PP
\fB-o\fP, \fB--option\fP=[]
	set extended option (\fBkey=value\fR, can be specified multiple times)

.PP
\fB--pack-size\fP=0
	set target pack \fBsize\fR in MiB, created pack files may be larger (default: $VAULTIC_PACK_SIZE)

.PP
\fB--password-command\fP=""
	shell \fBcommand\fR to obtain the repository password from (default: $VAULTIC_PASSWORD_COMMAND)

.PP
\fB-p\fP, \fB--password-file\fP=""
	\fBfile\fR to read the repository password from (default: $VAULTIC_PASSWORD_FILE)

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	do not output comprehensive progress report

.PP
\fB-r\fP, \fB--repo\fP=""
	\fBrepository\fR to backup to or restore from (default: $VAULTIC_REPOSITORY)

.PP
\fB--repo-hot\fP=""
	hot part of a hot/cold \fBrepository\fR (cold storage; default: $VAULTIC_REPO_HOT)

.PP
\fB--repository-file\fP=""
	\fBfile\fR to read the repository location from (default: $VAULTIC_REPOSITORY_FILE)

.PP
\fB--retry-lock\fP=0s
	retry to lock the repository if it is already locked, takes a value like 5m or 2h (default: no retries)

.PP
\fB--stuck-request-timeout\fP=5m0s
	\fBduration\fR after which to retry stuck requests

.PP
\fB--tls-client-cert\fP=""
	path to a \fBfile\fR containing PEM encoded TLS client certificate and private key (default: $VAULTIC_TLS_CLIENT_CERT)

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	be verbose (specify multiple times or a level using --verbose=n``, max level/times is 2)

.PP
\fB--warm-up-batch\fP=1
	warm-up \fBbatch\fR size: packs per %ids invocation or parallel %id invocations (default: $VAULTIC_WARM_UP_BATCH)

.PP
\fB--warm-up-command\fP=""
	warm-up \fBcommand\fR for cold storage, with %id/%path/%ids/%paths (default: $VAULTIC_WARM_UP_COMMAND)

.PP
\fB--warm-up-wait\fP=0s
	max \fBduration\fR to wait for warm-up to take effect (default: $VAULTIC_WARM_UP_WAIT)

.PP
\fB--warm-up-wait-command\fP=""
	\fBcommand\fR to wait for warmed-up data (default: $VAULTIC_WARM_UP_WAIT_COMMAND)


