.PP
\fB--warm-up-wait\fP=0s
	max \fBduration\fR to wait for warm-up to take effect (default: $VAULTIC_WARM_UP_WAIT)

.PP
\fB--warm-up-wait-command\fP=""
	\fBcommand\fR to wait for warmed-up data (default: $VAULTIC_WARM_UP_WAIT_COMMAND)


